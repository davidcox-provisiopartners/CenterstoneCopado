    <formulas>
        <name>formulaIsSelfCallingPerson</name>
        <dataType>Boolean</dataType>
        <expression>{!Are_you_calling_about} = {!Self}</expression>
    </formulas>
    <formulas>
        <name>fxEpisode</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;a class=&quot;slds-button slds-button_brand&quot; target=&quot;_top&quot; href=&quot;&apos; &amp;
LEFT( {!$Api.Partner_Server_URL_600} , FIND( &apos;/services/&apos; , {!$Api.Partner_Server_URL_600})) &amp;{!oOpenEpisode.Id}&amp;
&apos;&quot;&gt;View Episode&lt;/a&gt;&apos;</expression>
    </formulas>
    <formulas>
        <name>fxFirstPrimaryConcern</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!primaryconcernsduallist.selectedOptionsCSV},&apos;,&apos;,&apos;;&apos;)</expression>
    </formulas>
    <formulas>
        <name>fxNewEI</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;a class=&quot;slds-button slds-button_brand&quot; target=&quot;_top&quot; href=&quot;&apos; &amp;
LEFT( {!$Api.Partner_Server_URL_600} , FIND( &apos;/services/&apos; , {!$Api.Partner_Server_URL_600})) &amp;{!vEI} &amp;
&apos;&quot;&gt;Open Engagement Interaction&lt;/a&gt;&apos;</expression>
    </formulas>
    <formulas>
        <name>fxPatient</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;a class=&quot;slds-button slds-button_brand&quot; target=&quot;_top&quot; href=&quot;&apos; &amp;
LEFT( {!$Api.Partner_Server_URL_600} , FIND( &apos;/services/&apos; , {!$Api.Partner_Server_URL_600})) &amp;{!vPatient}&amp;
&apos;&quot;&gt;Open Patient Record&lt;/a&gt;&apos;</expression>
    </formulas>
    <formulas>
        <name>fxPatient1LastName</name>
        <dataType>String</dataType>
        <expression>if(isblank({!getPatient.LastName}),{!Search_for_Patient_by_Last_Name},{!getPatient.LastName})</expression>
    </formulas>
    <formulas>
        <description>for the episode record, we&apos;ll add the id of either the professional contact or the personal contact</description>
        <name>fxReferringContact</name>
        <dataType>String</dataType>
        <expression>if(isnull({!vProfContact}),{!vCaller},{!vProfContact}
)</expression>
    </formulas>
    <formulas>
        <name>fxRelationship</name>
        <dataType>String</dataType>
        <expression>if({!vProfessional},{!Provider_or_Professional_Referral},null)</expression>
    </formulas>
    <formulas>
        <name>fxSelfOther</name>
        <dataType>String</dataType>
        <expression>if({!vProfessional},{!Other},null)</expression>
    </formulas>
    <formulas>
        <name>fxSubPrimaryConcern</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!subprimaryconcernsduallist.selectedOptionsCSV},&apos;,&apos;,&apos;;&apos;)</expression>
    </formulas>
    <formulas>
        <name>fxSubsLastName</name>
        <dataType>String</dataType>
        <expression>if(isblank({!getSubsPA.LastName}),{!vSubsLastName},{!getSubsPA.LastName})</expression>
    </formulas>
    <formulas>
        <name>left3recordId</name>
        <dataType>String</dataType>
        <expression>left({!recordId},3)</expression>
    </formulas>
