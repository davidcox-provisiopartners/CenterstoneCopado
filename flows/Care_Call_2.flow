    <collectionProcessors>
        <name>FilterTheCallers</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>FilterTheCallers</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Collection_Filter_4_0</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>getPotentialCallerMatches</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Collection_Filter_4_0.FirstName</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Caller_First_Name_ForSearch</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>setPotentialPatientCallersToFiltered</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <name>FilterThePatients</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>FilterThePatients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Collection_Filter_4</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>getPotentialPatientMatches</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Collection_Filter_4.FirstName</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Patient_First_Name_ForSearch</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>setPotentialPatientMatchesToFiltered</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <name>FilterTheProfessionals</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>FilterTheProfessionals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_FilterTheCaller</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>getPotentialProfessionalMatches</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_FilterTheCaller.FirstName</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Professional_First_Name_ForSearch</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>setPotentialProfessionalsToFiltered</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Any_Last_Names</name>
        <label>Any Last Names?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>getPatient</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_one_or_more_last_names_to_search_for</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Search_for_Patient_by_Last_Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Search_for_Caller_Individual_by_Last_Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Search_for_Professional_by_Last_Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getPotentialPatientMatches</targetReference>
            </connector>
            <label>Yes - one or more last names to search for</label>
        </rules>
    </decisions>
    <decisions>
        <name>Any_Potential_Matches</name>
        <label>Any Potential Matches?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>NoMatchesScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_at_least_one_potential_match_by_last_name</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>countCallerMatches</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>countPatientMatches</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>countProfessionalMatches</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>LookupPage</targetReference>
            </connector>
            <label>Yes - at least one potential match by last name</label>
        </rules>
    </decisions>
    <decisions>
        <name>Anything_we_can_fill_in_so_far</name>
        <label>Anything we can fill in so far?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Any_Last_Names</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Correct_self_patient</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_this_the_correct_patient</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Yes</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>set_vPatient</targetReference>
            </connector>
            <label>Correct self patient</label>
        </rules>
        <rules>
            <name>Correct_ind_caller</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Is_this_the_correct_caller</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Yes</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>set_vCaller</targetReference>
            </connector>
            <label>Correct ind caller</label>
        </rules>
        <rules>
            <name>Correct_professional</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_this_the_correct_professional</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Yes</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>set_vProfContact</targetReference>
            </connector>
            <label>Correct professional</label>
        </rules>
    </decisions>
    <decisions>
        <description>Did the user click &quot;Autofill&quot; button? If yes, take info from the alt fields. If no, take info from the original fields.</description>
        <name>autofill_or_no</name>
        <label>autofill or no?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>update_vPatientWithOriginalFields</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Autofill_button_was_used</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CareFlowContactAutoFill.IsSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_vPatientWithAlFields</targetReference>
            </connector>
            <label>Autofill button was used</label>
        </rules>
    </decisions>
    <decisions>
        <name>AutoFillSelected</name>
        <label>AutoFillSelected?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>UpdateSubsPatient</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Autofill_selected_for_subs_patient</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>subsautofillflow.IsSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateSubsPatientAutoFill</targetReference>
            </connector>
            <label>Yes - Autofill selected for subs patient</label>
        </rules>
    </decisions>
    <decisions>
        <name>Caller_Is_the_count_over_1999</name>
        <label>Caller -  Is the count over 1999?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>getPotentialProfessionalMatches</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Caller_Yes_Must_be_a_popular_surname</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>countCallerMatches</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1999.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Caller_MoreThan2000PatientMatches</targetReference>
            </connector>
            <label>Yes! Must be a popular surname</label>
        </rules>
    </decisions>
    <decisions>
        <name>Caller_Selected</name>
        <label>Caller Selected</label>
        <locationX>0</locationX>
